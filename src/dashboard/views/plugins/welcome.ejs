<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenidas — <%= guild.name %></title>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="panel-layout">
        <%- include('../partials/sidebar', { guild, settings, active: 'welcome' }) %>

        <div class="panel-content">
            <h1 class="page-title"><i data-lucide="hand"></i> Bienvenidas y Despedidas</h1>
            <p class="page-desc">Configura los mensajes y tarjetas que se envían cuando alguien se une o se va del servidor.</p>

            <form id="welcome-form">
                <!-- BIENVENIDAS -->
                <div class="config-section">
                    <div class="config-section-header">
                        <div>
                            <h3>Mensaje de bienvenida</h3>
                            <p>Se envía cuando un usuario se une al servidor</p>
                        </div>
                        <label class="toggle">
                            <input type="checkbox" name="plugins.welcome" <%= settings.plugins?.welcome ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Canal de bienvenida</label>
                        <select name="welcome_channel">
                            <option value="">Selecciona un canal</option>
                            <% channels.forEach(ch => { %>
                                <option value="<%= ch.id %>" <%= settings.welcome_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Mensaje de bienvenida</label>
                        <textarea name="welcome_message" rows="3" placeholder="¡Bienvenido/a {user} a {server}! Ya somos {count} 🎉"><%= settings.welcome_message || '' %></textarea>
                        <small>Variables: <code>{user}</code> mención · <code>{server}</code> nombre del server · <code>{count}</code> total miembros</small>
                    </div>
                </div>

                <!-- TARJETA DE BIENVENIDA -->
                <div class="config-section">
                    <div class="config-section-header">
                        <div>
                            <h3>Tarjeta de bienvenida</h3>
                            <p>Envía una imagen personalizada junto al mensaje</p>
                        </div>
                        <label class="toggle">
                            <input type="checkbox" name="welcome_card" <%= settings.welcome_card ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label><i data-lucide="image" class="icon-sm"></i> Imagen de fondo de la tarjeta</label>
                        <input type="text" name="welcome_card_image" id="card-image-input" placeholder="https://ejemplo.com/mi-imagen.png" value="<%= settings.welcome_card_image || '' %>">
                        <small>Pega la URL de una imagen (se detectan enlaces de Imgur automáticamente). Recomendado: 800×300 px.</small>
                    </div>

                    <div class="form-group">
                        <label><i data-lucide="type" class="icon-sm"></i> Texto de la tarjeta <span class="badge-premium">PRO</span></label>
                        <input type="text" name="welcome_card_text" id="card-text-input" placeholder="{user} se ha unido al servidor" value="<%= settings.welcome_card_text || '' %>" <%= !settings.premium ? 'disabled' : '' %>>
                        <small>Variables: <code>{user}</code> nombre · <code>{server}</code> servidor · <code>{count}</code> miembros. <% if (!settings.premium) { %><a href="/dashboard/<%= guild.id %>/premium" style="color:var(--gold)">Hazte Premium</a> para personalizar.<% } %></small>
                    </div>

                    <div class="welcome-card-preview" id="card-preview">
                        <% if (settings.welcome_card_image) { %>
                            <img src="<%= settings.welcome_card_image %>" alt="Card background" class="welcome-card-bg-img" id="card-bg-img">
                        <% } else { %>
                            <img src="" alt="" class="welcome-card-bg-img" id="card-bg-img" style="display:none">
                        <% } %>
                        <div class="welcome-card-overlay">
                            <div class="welcome-card-avatar"><i data-lucide="user" class="icon-xl"></i></div>
                            <p class="welcome-card-text" id="card-text-preview"><%= settings.welcome_card_text || 'usuario#0000 se ha unido al servidor' %></p>
                            <p class="welcome-card-sub">Miembro #<%= guild.memberCount %></p>
                        </div>
                    </div>
                </div>

                <!-- DM DE BIENVENIDA -->
                <div class="config-section">
                    <div class="config-section-header">
                        <div>
                            <h3>Mensaje privado de bienvenida</h3>
                            <p>Envía un DM al usuario cuando se une</p>
                        </div>
                        <label class="toggle">
                            <input type="checkbox" name="welcome_dm" <%= settings.welcome_dm ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Mensaje privado</label>
                        <textarea name="welcome_dm_message" rows="3" placeholder="¡Hola {user}! Bienvenido/a a {server}. Lee las reglas para empezar."><%= settings.welcome_dm_message || '' %></textarea>
                    </div>
                </div>

                <!-- DESPEDIDAS -->
                <div class="config-section">
                    <div class="config-section-header">
                        <div>
                            <h3>Mensaje de despedida</h3>
                            <p>Se envía cuando un usuario abandona el servidor</p>
                        </div>
                        <label class="toggle">
                            <input type="checkbox" name="plugins.leave" <%= settings.plugins?.leave ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Canal de despedida</label>
                        <select name="leave_channel">
                            <option value="">Selecciona un canal</option>
                            <% channels.forEach(ch => { %>
                                <option value="<%= ch.id %>" <%= settings.leave_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Mensaje de despedida</label>
                        <textarea name="leave_message" rows="3" placeholder="{user} se ha ido de {server}. Ahora somos {count}."><%= settings.leave_message || '' %></textarea>
                    </div>
                </div>

                <!-- AUTOROLE (dentro de welcome) -->
                <div class="config-section">
                    <div class="config-section-header">
                        <div>
                            <h3>Dar un rol a los nuevos usuarios</h3>
                            <p>Los roles se otorgan automáticamente al unirse</p>
                        </div>
                        <label class="toggle">
                            <input type="checkbox" name="plugins.autorole" <%= settings.plugins?.autorole ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Rol a asignar</label>
                        <select name="autorole">
                            <option value="">Selecciona un rol</option>
                            <% roles.forEach(r => { %>
                                <option value="<%= r.id %>" <%= settings.autorole === r.id ? 'selected' : '' %>>@<%= r.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg"><i data-lucide="save" class="icon-sm"></i> Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        lucide.createIcons();
        const guildId = '<%= guild.id %>';

        // ── Normalizar URLs de imagen ──
        function normalizeImageUrl(url) {
            // imgur: https://imgur.com/xF3uHKV → https://i.imgur.com/xF3uHKV.png
            const imgurMatch = url.match(/^https?:\/\/(?:www\.)?imgur\.com\/(\w+)$/);
            if (imgurMatch) return `https://i.imgur.com/${imgurMatch[1]}.png`;

            // imgur con extensión pero dominio incorrecto
            const imgurMatch2 = url.match(/^https?:\/\/(?:www\.)?imgur\.com\/(\w+\.\w+)$/);
            if (imgurMatch2) return `https://i.imgur.com/${imgurMatch2[1]}`;

            return url;
        }

        // ── Live preview ──
        const cardImageInput = document.getElementById('card-image-input');
        const cardTextInput = document.getElementById('card-text-input');
        const cardBgImg = document.getElementById('card-bg-img');
        const cardTextPreview = document.getElementById('card-text-preview');

        function updateCardImage() {
            let url = cardImageInput.value.trim();
            if (url) {
                url = normalizeImageUrl(url);
                cardBgImg.src = url;
                cardBgImg.style.display = 'block';
                cardBgImg.onerror = () => { cardBgImg.style.display = 'none'; };
            } else {
                cardBgImg.style.display = 'none';
            }
        }

        cardImageInput.addEventListener('input', updateCardImage);
        // cargar preview al abrir la página si ya hay URL guardada
        updateCardImage();

        cardTextInput.addEventListener('input', () => {
            const text = cardTextInput.value.trim();
            cardTextPreview.textContent = text || 'usuario#0000 se ha unido al servidor';
        });

        // ── Save form ──
        document.getElementById('welcome-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader-2" class="icon-sm" style="animation:spin 1s linear infinite"></i> Guardando...';
            lucide.createIcons();

            const formData = new FormData(e.target);
            const data = {};

            for (const [key, val] of formData.entries()) {
                data[key] = val;
            }

            // checkboxes (no incluidos si no están checked)
            ['plugins.welcome', 'plugins.leave', 'plugins.autorole', 'welcome_card', 'welcome_dm'].forEach(k => {
                data[k] = e.target.querySelector(`[name="${k}"]`)?.checked || false;
            });

            // normalizar URL de imagen antes de guardar
            if (data.welcome_card_image) {
                data.welcome_card_image = normalizeImageUrl(data.welcome_card_image);
            }

            try {
                const res = await fetch(`/api/guilds/${guildId}/settings`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    showToast('Configuración guardada correctamente', 'success');
                } else {
                    showToast('Error al guardar la configuración', 'error');
                }
            } catch {
                showToast('Error de conexión', 'error');
            }

            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="save" class="icon-sm"></i> Guardar cambios';
            lucide.createIcons();
        });
    </script>
    <%- include('../partials/toast') %>
</body>
</html>
