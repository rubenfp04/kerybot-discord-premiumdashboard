<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t("welcome.title") %> — <%= guild.name %></title>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="panel-layout">
        <%- include('../partials/sidebar', { guild, settings, active: 'welcome' }) %>

        <div class="panel-content">
            <h1 class="page-title"><i data-lucide="hand"></i> <%= t("welcome.title") %></h1>
            <p class="page-desc"><%= t("welcome.desc") %></p>

            <!-- TABS -->
            <% const tab = typeof activeTab !== 'undefined' ? activeTab : 'mensaje'; %>
            <div class="config-tabs">
                <button class="config-tab <%= tab === 'mensaje' ? 'active' : '' %>" data-tab="mensaje">
                    <i data-lucide="message-square" class="icon-sm"></i> <%= t("welcome.tabMessage") %>
                </button>
                <button class="config-tab <%= tab === 'tipo' ? 'active' : '' %>" data-tab="tipo">
                    <i data-lucide="layout" class="icon-sm"></i> <%= t("welcome.tabType") %>
                </button>
                <button class="config-tab <%= tab === 'roles' ? 'active' : '' %>" data-tab="roles">
                    <i data-lucide="user-plus" class="icon-sm"></i> <%= t("welcome.tabRoles") %>
                </button>
                <button class="config-tab <%= tab === 'despedida' ? 'active' : '' %>" data-tab="despedida">
                    <i data-lucide="log-out" class="icon-sm"></i> <%= t("welcome.tabFarewell") %>
                </button>
            </div>

            <form id="welcome-form">

                <!-- ═══ TAB: MESSAGE ═══ -->
                <div class="tab-panel <%= tab === 'mensaje' ? 'active' : '' %>" data-panel="mensaje">
                    <div class="config-section">
                        <div class="config-section-header">
                            <div>
                                <h3><%= t("welcome.welcomeMessage") %></h3>
                                <p><%= t("welcome.welcomeMessageDesc") %></p>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" name="plugins.welcome" <%= settings.plugins?.welcome ? 'checked' : '' %>>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div class="form-group">
                            <label><i data-lucide="hash" class="icon-sm"></i> <%= t("welcome.channel") %></label>
                            <select name="welcome_channel">
                                <option value=""><%= t("welcome.selectChannel") %></option>
                                <% channels.forEach(ch => { %>
                                    <option value="<%= ch.id %>" <%= settings.welcome_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label><i data-lucide="text" class="icon-sm"></i> <%= t("welcome.messageLabel") %></label>
                            <textarea name="welcome_message" rows="3" placeholder="<%= t('welcome.messagePlaceholder') %>"><%= settings.welcome_message || '' %></textarea>
                            <small><%= t("welcome.variables") %> <code>{user}</code> <%= t("welcome.varUser") %> · <code>{server}</code> <%= t("welcome.varServer") %> · <code>{count}</code> <%= t("welcome.varCount") %></small>
                        </div>
                    </div>

                    <!-- DM -->
                    <div class="config-section">
                        <div class="config-section-header">
                            <div>
                                <h3><i data-lucide="mail" class="icon-sm"></i> <%= t("welcome.dmTitle") %></h3>
                                <p><%= t("welcome.dmDesc") %></p>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" name="welcome_dm" <%= settings.welcome_dm ? 'checked' : '' %>>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div class="form-group">
                            <label><%= t("welcome.dmLabel") %></label>
                            <textarea name="welcome_dm_message" rows="3" placeholder="<%= t('welcome.dmPlaceholder') %>"><%= settings.welcome_dm_message || '' %></textarea>
                            <small>Variables: <code>{user}</code> <code>{server}</code> <code>{count}</code></small>
                        </div>
                    </div>
                </div>

                <!-- ═══ TAB: SEND TYPE ═══ -->
                <div class="tab-panel <%= tab === 'tipo' ? 'active' : '' %>" data-panel="tipo">
                    <div class="config-section">
                        <div class="config-section-header">
                            <div>
                                <h3><%= t("welcome.formatTitle") %></h3>
                                <p><%= t("welcome.formatDesc") %></p>
                            </div>
                        </div>

                        <div class="welcome-type-selector">
                            <label class="welcome-type-option <%= !settings.welcome_card ? 'selected' : '' %>">
                                <input type="radio" name="welcome_type" value="embed" <%= !settings.welcome_card ? 'checked' : '' %>>
                                <div class="welcome-type-card">
                                    <div class="welcome-type-icon"><i data-lucide="message-square"></i></div>
                                    <h4><%= t("welcome.embedOption") %></h4>
                                    <p><%= t("welcome.embedDesc") %></p>
                                </div>
                            </label>
                            <label class="welcome-type-option <%= settings.welcome_card ? 'selected' : '' %>">
                                <input type="radio" name="welcome_type" value="card" <%= settings.welcome_card ? 'checked' : '' %>>
                                <div class="welcome-type-card">
                                    <div class="welcome-type-icon"><i data-lucide="image"></i></div>
                                    <h4><%= t("welcome.cardOption") %></h4>
                                    <p><%= t("welcome.cardDesc") %></p>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Card settings (shown when card is selected) -->
                    <div class="config-section card-settings" style="<%= settings.welcome_card ? '' : 'display:none' %>">
                        <div class="config-section-header">
                            <div>
                                <h3><i data-lucide="image" class="icon-sm"></i> <%= t("welcome.cardSettings") %></h3>
                                <p><%= t("welcome.cardSettingsDesc") %></p>
                            </div>
                        </div>

                        <div class="form-group">
                            <label><i data-lucide="image" class="icon-sm"></i> <%= t("welcome.bgImage") %></label>
                            <input type="text" name="welcome_card_image" id="card-image-input" placeholder="<%= t('welcome.bgImagePlaceholder') %>" value="<%= settings.welcome_card_image || '' %>">
                            <small><%= t("welcome.bgImageHint") %></small>
                        </div>

                        <div class="form-group">
                            <label><i data-lucide="hash" class="icon-sm"></i> <%= t("welcome.cardChannel") %></label>
                            <select name="welcome_card_channel" class="custom-select">
                                <option value=""><%= t("welcome.sameWelcomeChannel") %></option>
                                <% channels.forEach(ch => { %>
                                    <option value="<%= ch.id %>" <%= settings.welcome_card_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                <% }) %>
                            </select>
                            <small><%= t("welcome.cardChannelHint") %></small>
                        </div>

                        <div class="form-group">
                            <label><i data-lucide="type" class="icon-sm"></i> <%= t("welcome.cardText") %> <span class="badge-premium">PRO</span></label>
                            <input type="text" name="welcome_card_text" id="card-text-input" placeholder="<%= t('welcome.messagePlaceholder') %>" value="<%= settings.welcome_card_text || '' %>" <%= !settings.premium ? 'disabled' : '' %>>
                            <small><%= t("welcome.cardTextHint") %> <% if (!settings.premium) { %><a href="/dashboard/<%= guild.id %>/premium" style="color:var(--gold)"><%= t("welcome.premiumCustomize") %></a><% } %></small>
                        </div>

                        <div class="welcome-card-preview" id="card-preview">
                            <% if (settings.welcome_card_image) { %>
                                <img src="<%= settings.welcome_card_image %>" alt="Card background" class="welcome-card-bg-img" id="card-bg-img">
                            <% } else { %>
                                <img src="" alt="" class="welcome-card-bg-img" id="card-bg-img" style="display:none">
                            <% } %>
                            <div class="welcome-card-overlay">
                                <div class="welcome-card-avatar"><i data-lucide="user" class="icon-xl"></i></div>
                                <p class="welcome-card-text" id="card-text-preview"><%= settings.welcome_card_text || t('welcome.messagePlaceholder') %></p>
                                <p class="welcome-card-sub"><%= t("welcome.memberNumber") %><%= guild.memberCount %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ═══ TAB: WELCOME ROLE ═══ -->
                <div class="tab-panel <%= tab === 'roles' ? 'active' : '' %>" data-panel="roles">
                    <div class="config-section">
                        <div class="config-section-header">
                            <div>
                                <h3><i data-lucide="user-plus" class="icon-sm"></i> <%= t("welcome.tabRoles") %></h3>
                                <p><%= t("welcome.autoroleDesc") %></p>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" name="plugins.autorole" <%= settings.plugins?.autorole ? 'checked' : '' %>>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div class="form-group">
                            <label><i data-lucide="shield" class="icon-sm"></i> <%= t("welcome.roleLabel") %></label>
                            <select name="autorole">
                                <option value=""><%= t("welcome.selectRole") %></option>
                                <% roles.forEach(r => { %>
                                    <option value="<%= r.id %>" <%= settings.autorole === r.id ? 'selected' : '' %>>@<%= r.name %></option>
                                <% }) %>
                            </select>
                            <small><%= t("welcome.autoroleHint") %></small>
                        </div>
                    </div>
                </div>

                <!-- ═══ TAB: FAREWELL ═══ -->
                <div class="tab-panel <%= tab === 'despedida' ? 'active' : '' %>" data-panel="despedida">
                    <div class="config-section">
                        <div class="config-section-header">
                            <div>
                                <h3><%= t("welcome.farewellTitle") %></h3>
                                <p><%= t("welcome.farewellDesc") %></p>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" name="plugins.leave" <%= settings.plugins?.leave ? 'checked' : '' %>>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div class="form-group">
                            <label><i data-lucide="hash" class="icon-sm"></i> <%= t("welcome.farewellChannel") %></label>
                            <select name="leave_channel">
                                <option value=""><%= t("common.selectChannel") %></option>
                                <% channels.forEach(ch => { %>
                                    <option value="<%= ch.id %>" <%= settings.leave_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label><i data-lucide="text" class="icon-sm"></i> <%= t("welcome.farewellLabel") %></label>
                            <textarea name="leave_message" rows="3" placeholder="<%= t('welcome.farewellPlaceholder') %>"><%= settings.leave_message || '' %></textarea>
                            <small>Variables: <code>{user}</code> <code>{server}</code> <code>{count}</code></small>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg"><i data-lucide="save" class="icon-sm"></i> <%= t("common.save") %></button>
                </div>
            </form>
        </div>
    </div>

    <script>
        lucide.createIcons();
        const guildId = '<%= guild.id %>';

        // ── Tabs ──
        document.querySelectorAll('.config-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.config-tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                tab.classList.add('active');
                document.querySelector(`[data-panel="${tab.dataset.tab}"]`).classList.add('active');
            });
        });

        // ── Welcome type selector ──
        document.querySelectorAll('.welcome-type-option input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.welcome-type-option').forEach(opt => opt.classList.remove('selected'));
                radio.closest('.welcome-type-option').classList.add('selected');
                const cardSettings = document.querySelector('.card-settings');
                if (radio.value === 'card') {
                    cardSettings.style.display = '';
                } else {
                    cardSettings.style.display = 'none';
                }
            });
        });

        // ── Normalizar URLs de imagen ──
        function normalizeImageUrl(url) {
            const imgurMatch = url.match(/^https?:\/\/(?:www\.)?imgur\.com\/(\w+)$/);
            if (imgurMatch) return `https://i.imgur.com/${imgurMatch[1]}.png`;
            const imgurMatch2 = url.match(/^https?:\/\/(?:www\.)?imgur\.com\/(\w+\.\w+)$/);
            if (imgurMatch2) return `https://i.imgur.com/${imgurMatch2[1]}`;
            return url;
        }

        // ── Live preview ──
        const cardImageInput = document.getElementById('card-image-input');
        const cardTextInput = document.getElementById('card-text-input');
        const cardBgImg = document.getElementById('card-bg-img');
        const cardTextPreview = document.getElementById('card-text-preview');

        function updateCardImage() {
            if (!cardImageInput) return;
            let url = cardImageInput.value.trim();
            if (url) {
                url = normalizeImageUrl(url);
                cardBgImg.src = url;
                cardBgImg.style.display = 'block';
                cardBgImg.onerror = () => { cardBgImg.style.display = 'none'; };
            } else {
                cardBgImg.style.display = 'none';
            }
        }

        if (cardImageInput) {
            cardImageInput.addEventListener('input', updateCardImage);
            updateCardImage();
        }

        if (cardTextInput) {
            cardTextInput.addEventListener('input', () => {
                const text = cardTextInput.value.trim();
                cardTextPreview.textContent = text || '<%= t("welcome.messagePlaceholder") %>';
            });
        }

        // ── Save form ──
        document.getElementById('welcome-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader-2" class="icon-sm" style="animation:spin 1s linear infinite"></i> <%= t('common.saving') %>';
            lucide.createIcons();

            const formData = new FormData(e.target);
            const data = {};

            for (const [key, val] of formData.entries()) {
                if (key === 'welcome_type') continue;
                data[key] = val;
            }

            // welcome_card based on type selector
            const typeRadio = e.target.querySelector('input[name="welcome_type"]:checked');
            data.welcome_card = typeRadio ? typeRadio.value === 'card' : false;

            // checkboxes
            ['plugins.welcome', 'plugins.leave', 'plugins.autorole', 'welcome_dm'].forEach(k => {
                data[k] = e.target.querySelector(`[name="${k}"]`)?.checked || false;
            });

            if (data.welcome_card_image) {
                data.welcome_card_image = normalizeImageUrl(data.welcome_card_image);
            }

            try {
                const res = await fetch(`/api/guilds/${guildId}/settings`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    showToast('<%= t("common.saved") %>', 'success');
                } else {
                    showToast('<%= t("common.errorSave") %>', 'error');
                }
            } catch {
                showToast('<%= t("common.errorConnection") %>', 'error');
            }

            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="save" class="icon-sm"></i> <%= t("common.save") %>';
            lucide.createIcons();
        });
    </script>
    <%- include('../partials/toast') %>
    <%- include('../partials/custom-select') %>
</body>
</html>
