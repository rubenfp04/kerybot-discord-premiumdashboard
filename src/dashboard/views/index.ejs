<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>kerybot — <%= t('landing.title') %></title>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="hero">
        <div class="hero-bubbles" id="bubbles"></div>

        <div class="hero-jellyfish" aria-hidden="true">
            <div class="jelly-body"></div>
            <div class="jelly-tentacles">
                <div class="tentacle"></div>
                <div class="tentacle"></div>
                <div class="tentacle"></div>
                <div class="tentacle"></div>
                <div class="tentacle"></div>
                <div class="tentacle"></div>
                <div class="tentacle"></div>
            </div>
        </div>

        <div class="hero-content">
            <h1><%= botName %></h1>
            <p class="hero-subtitle"><%= t('landing.subtitle') %></p>

            <div class="hero-stats">
                <div class="stat">
                    <span class="stat-number"><%= serverCount %></span>
                    <span class="stat-label"><%= t('landing.servers') %></span>
                </div>
                <div class="stat">
                    <span class="stat-number"><%= userCount %></span>
                    <span class="stat-label"><%= t('landing.users') %></span>
                </div>
                <div class="stat">
                    <span class="stat-number"><%= commandCount %></span>
                    <span class="stat-label"><%= t('landing.commands') %></span>
                </div>
            </div>

            <div class="hero-buttons">
                <% if (user) { %>
                    <a href="/dashboard" class="btn btn-primary"><%= t('landing.openDashboard') %></a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-primary"><%= t('landing.getStarted') %></a>
                <% } %>
                <a href="https://github.com" class="btn btn-secondary" target="_blank">GitHub</a>
            </div>
        </div>
    </section>

    <section class="features" id="features">
        <h2><%= t('landing.features') %></h2>
        <p class="section-desc"><%= t('landing.featuresDesc') %></p>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon"><i data-lucide="shield-check"></i></div>
                <h3><%= t('landing.moderation') %></h3>
                <p><%= t('landing.moderationDesc') %></p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i data-lucide="hand"></i></div>
                <h3><%= t('landing.welcomes') %></h3>
                <p><%= t('landing.welcomesDesc') %></p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i data-lucide="bar-chart-3"></i></div>
                <h3><%= t('landing.levels') %></h3>
                <p><%= t('landing.levelsDesc') %></p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i data-lucide="smile-plus"></i></div>
                <h3><%= t('landing.reactionRoles') %></h3>
                <p><%= t('landing.reactionRolesDesc') %></p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i data-lucide="star"></i></div>
                <h3><%= t('landing.starboard') %></h3>
                <p><%= t('landing.starboardDesc') %></p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i data-lucide="settings"></i></div>
                <h3><%= t('landing.webDashboard') %></h3>
                <p><%= t('landing.webDashboardDesc') %></p>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>

    <script>
        lucide.createIcons();

        // generate bubbles
        const container = document.getElementById('bubbles');
        for (let i = 0; i < 15; i++) {
            const b = document.createElement('div');
            b.classList.add('bubble');
            const size = Math.random() * 20 + 5;
            b.style.width = size + 'px';
            b.style.height = size + 'px';
            b.style.left = Math.random() * 100 + '%';
            b.style.animationDuration = (Math.random() * 10 + 8) + 's';
            b.style.animationDelay = (Math.random() * 6) + 's';
            container.appendChild(b);
        }
    </script>
</body>
</html>
