<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= guild.name %> — kerybot</title>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="panel-layout">
        <%- include('partials/sidebar', { guild, settings, active: 'home' }) %>

        <!-- MAIN CONTENT — Plugin overview -->
        <div class="panel-content-full">
            <h1 class="page-title"><i data-lucide="puzzle"></i> <%= t('guild.plugins') %></h1>
            <p class="page-desc"><%= t('guild.pluginsDesc') %></p>

            <% if (settings.premium) { %>
                <div class="config-section premium-status-active" style="margin-bottom:1.5rem">
                    <div class="premium-status-header">
                        <div class="premium-status-icon">
                            <i data-lucide="crown" class="icon-lg"></i>
                        </div>
                        <div>
                            <h3>🎉 ¡Servidor Premium activo!</h3>
                            <p>
                                Plan: <strong><%= settings.premium_type === 'lifetime' ? 'De por vida' : settings.premium_type === 'yearly' ? 'Anual' : 'Mensual' %></strong>
                                <% if (settings.premium_until) { %>
                                    · Hasta: <strong><%= new Date(settings.premium_until).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong>
                                <% } else { %>
                                    · <strong>Sin expiración</strong>
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <a href="/dashboard/<%= guild.id %>/premium" class="btn btn-small btn-gold"><%= t('guild.manage') %></a>
                </div>
            <% } else { %>
                <div class="config-section premium-status-free" style="margin-bottom:1.5rem">
                    <div class="premium-status-header">
                        <div class="premium-status-icon free">
                            <i data-lucide="sparkles" class="icon-lg"></i>
                        </div>
                        <div>
                            <h3><%= t('guild.upgradePremium') %></h3>
                            <p><%= t('guild.unlockFeatures') %></p>
                        </div>
                    </div>
                    <a href="/dashboard/<%= guild.id %>/premium" class="btn btn-small btn-gold">Hazte PRO</a>
                </div>
            <% } %>

            <!-- ESENCIALES -->
            <h3 class="plugins-section-title"><%= t('guild.essentials') %></h3>
            <div class="plugin-grid">
                <div class="plugin-card">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="hand"></i></div>
                    </div>
                    <h3><%= t('guild.welcomeTitle') %></h3>
                    <p><%= t('guild.welcomeDesc') %></p>
                    <div class="plugin-card-footer">
                        <a href="/dashboard/<%= guild.id %>/welcome" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                        <label class="toggle">
                            <input type="checkbox" data-plugin="welcome" <%= settings.plugins?.welcome ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="plugin-card">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="user-plus"></i></div>
                    </div>
                    <h3><%= t('guild.autoroleTitle') %></h3>
                    <p><%= t('guild.autoroleDesc') %></p>
                    <div class="plugin-card-footer">
                        <a href="/dashboard/<%= guild.id %>/autorole" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                        <label class="toggle">
                            <input type="checkbox" data-plugin="autorole" <%= settings.plugins?.autorole ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="plugin-card">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="shield"></i></div>
                    </div>
                    <h3><%= t('guild.moderationTitle') %></h3>
                    <p><%= t('guild.moderationDesc') %></p>
                    <div class="plugin-card-footer">
                        <a href="/dashboard/<%= guild.id %>/moderation" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                        <label class="toggle">
                            <input type="checkbox" data-plugin="moderation" <%= settings.plugins?.moderation ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="plugin-card">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="smile-plus"></i></div>
                    </div>
                    <h3><%= t('guild.reactionRolesTitle') %></h3>
                    <p><%= t('guild.reactionRolesDesc') %></p>
                    <div class="plugin-card-footer">
                        <a href="/dashboard/<%= guild.id %>/reaction-roles" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                        <label class="toggle">
                            <input type="checkbox" data-plugin="reactionRoles" <%= settings.plugins?.reactionRoles ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="plugin-card">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="scroll-text"></i></div>
                    </div>
                    <h3><%= t('guild.logsTitle') %></h3>
                    <p><%= t('guild.logsDesc') %></p>
                    <div class="plugin-card-footer">
                        <a href="/dashboard/<%= guild.id %>/logs" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                        <label class="toggle">
                            <input type="checkbox" data-plugin="logs" <%= settings.plugins?.logs ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="plugin-card">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="ticket"></i></div>
                    </div>
                    <h3><%= t('guild.ticketsTitle') %></h3>
                    <p><%= t('guild.ticketsDesc') %></p>
                    <div class="plugin-card-footer">
                        <a href="/dashboard/<%= guild.id %>/tickets" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                        <label class="toggle">
                            <input type="checkbox" data-plugin="tickets" <%= settings.plugins?.tickets ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="plugin-card">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="lightbulb"></i></div>
                    </div>
                    <h3><%= t('guild.suggestionsTitle') %></h3>
                    <p><%= t('guild.suggestionsDesc') %></p>
                    <div class="plugin-card-footer">
                        <a href="/dashboard/<%= guild.id %>/suggestions" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                        <label class="toggle">
                            <input type="checkbox" data-plugin="suggestions" <%= settings.plugins?.suggestions ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- PREMIUM -->
            <h3 class="plugins-section-title"><%= t('guild.premium') %> ✨</h3>
            <div class="plugin-grid">
                <div class="plugin-card<%= !settings.premium ? ' plugin-card-locked' : '' %>">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="bar-chart-3"></i></div>
                        <span class="plugin-card-badge badge-gold">PRO</span>
                    </div>
                    <h3><%= t('guild.levelsTitle') %></h3>
                    <p><%= t('guild.levelsDesc') %></p>
                    <div class="plugin-card-footer">
                        <% if (settings.premium) { %>
                            <a href="/dashboard/<%= guild.id %>/levels" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                            <label class="toggle">
                                <input type="checkbox" data-plugin="levels" <%= settings.plugins?.levels ? 'checked' : '' %>>
                                <span class="toggle-slider"></span>
                            </label>
                        <% } else { %>
                            <a href="/dashboard/<%= guild.id %>/premium" class="btn btn-small btn-gold"><%= t('guild.getPro') %></a>
                            <label class="toggle">
                                <input type="checkbox" disabled>
                                <span class="toggle-slider"></span>
                            </label>
                        <% } %>
                    </div>
                </div>

                <div class="plugin-card<%= !settings.premium ? ' plugin-card-locked' : '' %>">
                    <div class="plugin-card-header">
                        <div class="plugin-card-icon"><i data-lucide="star"></i></div>
                        <span class="plugin-card-badge badge-gold">PRO</span>
                    </div>
                    <h3><%= t('guild.starboardTitle') %></h3>
                    <p><%= t('guild.starboardDesc') %></p>
                    <div class="plugin-card-footer">
                        <% if (settings.premium) { %>
                            <a href="/dashboard/<%= guild.id %>/starboard" class="btn btn-small btn-outline"><%= t('guild.configure') %></a>
                            <label class="toggle">
                                <input type="checkbox" data-plugin="starboard" <%= settings.plugins?.starboard ? 'checked' : '' %>>
                                <span class="toggle-slider"></span>
                            </label>
                        <% } else { %>
                            <a href="/dashboard/<%= guild.id %>/premium" class="btn btn-small btn-gold"><%= t('guild.getPro') %></a>
                            <label class="toggle">
                                <input type="checkbox" disabled>
                                <span class="toggle-slider"></span>
                            </label>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
        const guildId = '<%= guild.id %>';

        // Plugin toggles
        document.querySelectorAll('[data-plugin]').forEach(toggle => {
            toggle.addEventListener('change', async (e) => {
                const plugin = e.target.dataset.plugin;
                const enabled = e.target.checked;

                try {
                    const res = await fetch(`/api/guilds/${guildId}/plugins`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ plugin, enabled })
                    });
                    if (res.ok) {
                        showToast(enabled ? `${plugin} <%= t('guild.pluginEnabled') %>` : `${plugin} <%= t('guild.pluginDisabled') %>`, 'success');
                    } else {
                        showToast('<%= t('common.errorSave') %>', 'error');
                        e.target.checked = !enabled;
                    }
                } catch {
                    showToast('<%= t('common.errorConnection') %>', 'error');
                    e.target.checked = !enabled;
                }
            });
        });
    </script>
    <%- include('partials/toast') %>
</body>
</html>
