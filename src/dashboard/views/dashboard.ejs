<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('nav.dashboard') %> — kerybot</title>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="dashboard-main">
        <div class="dashboard-header">
            <h1><%= t('dashboard.selectServer') %></h1>
            <p><%= t('dashboard.selectDesc') %></p>
        </div>

        <div class="guild-grid">
            <% guilds.forEach(guild => { %>
                <div class="guild-card">
                    <div class="guild-card-banner">
                        <% if (guild.icon) { %>
                            <img src="<%= guild.icon %>" alt="<%= guild.name %>">
                        <% } else { %>
                            <div class="guild-icon-placeholder"><%= guild.name.charAt(0) %></div>
                        <% } %>
                    </div>
                    <div class="guild-card-body">
                        <div class="guild-card-info">
                            <h3><%= guild.name %></h3>
                            <% if (guild.botIn) { %>
                                <span class="guild-members"><%= guild.memberCount %> <%= t('dashboard.members') %></span>
                            <% } else { %>
                                <span class="badge badge-gray"><%= t('dashboard.botNotAdded') %></span>
                            <% } %>
                        </div>
                        <% if (guild.botIn) { %>
                            <a href="/dashboard/<%= guild.id %>" class="btn btn-primary btn-small"><%= t('dashboard.configure') %></a>
                        <% } else { %>
                            <a href="https://discord.com/oauth2/authorize?client_id=<%= process.env.CLIENT_ID %>&scope=bot+applications.commands&permissions=8&guild_id=<%= guild.id %>" class="btn btn-outline btn-small" target="_blank"><%= t('dashboard.invite') %></a>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script>lucide.createIcons();</script>
</body>
</html>
