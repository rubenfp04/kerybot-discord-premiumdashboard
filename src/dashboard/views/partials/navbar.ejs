<nav class="navbar">
    <div class="nav-brand">
        <a href="/"><img src="/img/logo.png" alt="kery" class="brand-logo"> kerybot</a>
    </div>
    <div class="nav-links">
        <a href="/#features"><%= t('nav.plugins') %></a>
        <% if (user) { %>
            <a href="/dashboard"><%= t('nav.dashboard') %></a>
            <div class="nav-user">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=32" alt="avatar" class="nav-avatar">
                <span><%= user.username %></span>
                <a href="/auth/logout" class="btn btn-small btn-secondary"><i data-lucide="log-out" class="icon-sm"></i> <%= t('nav.logout') %></a>
            </div>
        <% } else { %>
            <a href="/auth/login" class="btn btn-discord"><svg width="16" height="12" viewBox="0 0 71 55" fill="currentColor"><path d="M60.1 4.9A58.5 58.5 0 0045.4.2a.2.2 0 00-.2.1 40.8 40.8 0 00-1.8 3.7 54 54 0 00-16.2 0A37.4 37.4 0 0025.4.3a.2.2 0 00-.2-.1A58.4 58.4 0 0010.5 4.9a.2.2 0 00-.1.1C1.5 18.7-.9 32.2.3 45.5v.1a58.8 58.8 0 0017.7 9a.2.2 0 00.3-.1 42 42 0 003.6-5.9.2.2 0 00-.1-.3 38.8 38.8 0 01-5.5-2.6.2.2 0 01 0-.4l1.1-.9a.2.2 0 01.2 0 42 42 0 0035.6 0 .2.2 0 01.2 0l1.1.9a.2.2 0 010 .4 36.4 36.4 0 01-5.5 2.6.2.2 0 00-.1.3 47.2 47.2 0 003.6 5.9.2.2 0 00.3.1A58.6 58.6 0 0070.4 45.6v-.1c1.4-14.8-2.3-27.7-9.8-39.1a.2.2 0 00-.1 0zM23.7 37.3c-3.4 0-6.2-3.1-6.2-6.9s2.7-6.9 6.2-6.9 6.3 3.1 6.2 6.9c0 3.8-2.8 6.9-6.2 6.9zm22.9 0c-3.4 0-6.2-3.1-6.2-6.9s2.7-6.9 6.2-6.9 6.3 3.1 6.2 6.9c0 3.8-2.7 6.9-6.2 6.9z"/></svg> <%= t('nav.connectDiscord') %></a>
        <% } %>

        <div class="lang-dropdown">
            <button class="lang-dropdown-btn" onclick="this.parentElement.classList.toggle('open')">
                <span class="lang-flag"><%= lang === 'es' ? '🇪🇸' : '🇬🇧' %></span>
                <span class="lang-label"><%= lang === 'es' ? 'Español' : 'English' %></span>
                <i data-lucide="chevron-down" class="lang-chevron"></i>
            </button>
            <div class="lang-dropdown-menu">
                <a href="?lang=en" class="lang-option <%= lang === 'en' ? 'active' : '' %>">
                    <span class="lang-flag">🇬🇧</span> English
                </a>
                <a href="?lang=es" class="lang-option <%= lang === 'es' ? 'active' : '' %>">
                    <span class="lang-flag">🇪🇸</span> Español
                </a>
            </div>
        </div>
    </div>
</nav>
<script>
document.addEventListener('click', e => {
    document.querySelectorAll('.lang-dropdown.open').forEach(d => {
        if (!d.contains(e.target)) d.classList.remove('open');
    });
});
</script>
